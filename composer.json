{
  "name": "rollecode/simple-dark-mode-for-wp-dashboard",
  "type": "wordpress-plugin",
  "description": "The simplest way to make your WordPress dashboard dark. No settings: activate and enjoy the darkness.",
  "homepage": "https://github.com/rollecode/simple-dark-mode-for-wp-dashboard",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Rolle Laukkarinen",
      "email": "rolle@dude.fi",
      "homepage": "https://github.com/rollecode"
    }
  ],
  "require": {
    "php": ">=8.0",
    "composer/installers": "^2.0"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
